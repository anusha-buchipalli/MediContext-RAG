# ==============================================================================
# AURA CLINICAL AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and supply your credentials
# ==============================================================================

# Groq API Key (Free tier supported at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Pinecone Vector Database Credentials (app.pinecone.io)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=medical-chatbot
PINECONE_NAMESPACE=medical

# Groq Model Configurations (Optional overrides)
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3

# Server Settings (Optional)
FLASK_PORT=5000
FLASK_HOST=127.0.0.1